@model List<Appointment>
@{
    ViewData["Title"] = "Veteriner Paneli";
    var hekim = (Veterinarian)ViewBag.Hekim;
}

<div class="mb-4">
    <h1 class="h3 mb-0 text-vet fw-bold">Hoş geldiniz, @hekim.Title @hekim.FullName</h1>
    <p class="text-muted mb-0">@hekim.Clinic?.Name</p>
</div>

<div class="row g-4">
    <!-- Sol: hekim bilgileri -->
    <div class="col-lg-4">
        <div class="card border-0 shadow-sm mb-4">
            <div class="card-header bg-white fw-semibold">Uzmanlık Alanlarım</div>
            <div class="card-body">
                @foreach (var u in hekim.Specialties.OrderBy(s => s.Name))
                {
                    <span class="badge rounded-pill bg-vet me-1 mb-1">@u.Name</span>
                }
            </div>
        </div>

        <div class="card border-0 shadow-sm">
            <div class="card-header bg-white fw-semibold">Çalışma Saatlerim</div>
            <ul class="list-group list-group-flush">
                @foreach (var m in hekim.Availabilities.OrderBy(a => ((int)a.Day + 6) % 7).ThenBy(a => a.StartTime))
                {
                    <li class="list-group-item d-flex justify-content-between">
                        <span>@m.Day.TurkceAd()</span>
                        <span class="text-muted">@m.StartTime.ToString("HH:mm") – @m.EndTime.ToString("HH:mm")</span>
                    </li>
                }
            </ul>
        </div>
    </div>

    <!-- Sağ: yaklaşan randevular -->
    <div class="col-lg-8">
        <div class="card border-0 shadow-sm">
            <div class="card-header bg-white fw-semibold">
                Yaklaşan Randevularım
                <span class="badge bg-warning text-dark ms-2">@Model.Count(r => r.Status == AppointmentStatus.Bekliyor) onay bekliyor</span>
            </div>
            <div class="card-body p-0">
                @if (!Model.Any())
                {
                    <p class="text-muted p-3 mb-0">Yaklaşan randevunuz yok.</p>
                }
                else
                {
                    <div class="table-responsive">
                        <table class="table table-hover align-middle mb-0">
                            <thead class="table-light">
                                <tr>
                                    <th>Tarih / Saat</th>
                                    <th>Evcil Hayvan</th>
                                    <th>Hizmet</th>
                                    <th>Durum</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var r in Model)
                                {
                                    <tr>
                                        <td>@r.StartTime.ToString("dd.MM.yyyy HH:mm") – @r.EndTime.ToString("HH:mm")</td>
                                        <td>@r.Pet?.Name <small class="text-muted">(@r.Pet?.Species)</small></td>
                                        <td>@r.Service?.Name</td>
                                        <td><span class="badge @r.Status.RozetSinifi()">@r.Status.GorunenAd()</span></td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
            </div>
        </div>
        <p class="text-muted small mt-2">Randevu onaylama/reddetme ve muayene notu girme ekranları ilerleyen adımlarda eklenecek.</p>
    </div>
</div>
