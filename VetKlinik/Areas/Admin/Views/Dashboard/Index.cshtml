@model List<Appointment>
@{
    ViewData["Title"] = "Yönetim Paneli";
}

<div class="d-flex align-items-center justify-content-between mb-4">
    <div>
        <h1 class="h3 mb-0 text-vet fw-bold">Yönetim Paneli</h1>
        <p class="text-muted mb-0">Sistemin genel durumu</p>
    </div>
</div>

<!-- Özet kartları -->
<div class="row g-3 mb-4">
    <div class="col-6 col-lg-3"><div class="stat-card"><div class="stat-icon">🏥</div><div class="stat-value">@ViewBag.KlinikSayisi</div><div class="stat-label">Klinik</div></div></div>
    <div class="col-6 col-lg-3"><div class="stat-card"><div class="stat-icon">🩺</div><div class="stat-value">@ViewBag.VeterinerSayisi</div><div class="stat-label">Veteriner</div></div></div>
    <div class="col-6 col-lg-3"><div class="stat-card"><div class="stat-icon">💉</div><div class="stat-value">@ViewBag.HizmetSayisi</div><div class="stat-label">Hizmet</div></div></div>
    <div class="col-6 col-lg-3"><div class="stat-card"><div class="stat-icon">👥</div><div class="stat-value">@ViewBag.UyeSayisi</div><div class="stat-label">Üye</div></div></div>
    <div class="col-6 col-lg-4"><div class="stat-card"><div class="stat-icon">🐾</div><div class="stat-value">@ViewBag.HayvanSayisi</div><div class="stat-label">Evcil Hayvan</div></div></div>
    <div class="col-6 col-lg-4"><div class="stat-card stat-card-uyari"><div class="stat-icon">⏳</div><div class="stat-value">@ViewBag.BekleyenRandevu</div><div class="stat-label">Onay Bekleyen Randevu</div></div></div>
    <div class="col-12 col-lg-4"><div class="stat-card"><div class="stat-icon">📅</div><div class="stat-value">@ViewBag.BugunkuRandevu</div><div class="stat-label">Bugünkü Randevu</div></div></div>
</div>

<!-- Son randevular -->
<div class="card border-0 shadow-sm">
    <div class="card-header bg-white fw-semibold">Son Randevular</div>
    <div class="card-body p-0">
        @if (!Model.Any())
        {
            <p class="text-muted p-3 mb-0">Henüz randevu yok.</p>
        }
        else
        {
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light">
                        <tr>
                            <th>Tarih / Saat</th>
                            <th>Evcil Hayvan</th>
                            <th>Hizmet</th>
                            <th>Veteriner</th>
                            <th class="text-end">Ücret</th>
                            <th>Durum</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var r in Model)
                        {
                            <tr>
                                <td>@r.StartTime.ToString("dd.MM.yyyy HH:mm")</td>
                                <td>@r.Pet?.Name</td>
                                <td>@r.Service?.Name</td>
                                <td>@r.Veterinarian?.Title @r.Veterinarian?.FullName</td>
                                <td class="text-end">@r.Price.ToString("N2") ₺</td>
                                <td><span class="badge @r.Status.RozetSinifi()">@r.Status.GorunenAd()</span></td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>
</div>
