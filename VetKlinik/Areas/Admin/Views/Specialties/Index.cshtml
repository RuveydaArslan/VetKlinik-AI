@model List<Specialty>
@{
    ViewData["Title"] = "Uzmanlık Alanları";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h1 class="h3 mb-0 text-vet fw-bold">🎓 Uzmanlık Alanları</h1>
        <p class="text-muted mb-0">Veteriner hekimlere atanabilen uzmanlık alanları</p>
    </div>
    <a asp-action="Create" class="btn btn-vet">+ Yeni Uzmanlık</a>
</div>

@if (!Model.Any())
{
    <div class="alert alert-light border">Henüz uzmanlık alanı eklenmemiş.</div>
}
else
{
    <div class="card border-0 shadow-sm">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th>Uzmanlık Alanı</th>
                        <th>Açıklama</th>
                        <th>Hekimler</th>
                        <th class="text-end">İşlemler</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var u in Model)
                    {
                        <tr>
                            <td class="fw-semibold">@u.Name</td>
                            <td class="small text-muted">@u.Description</td>
                            <td>
                                @foreach (var v in u.Veterinarians.OrderBy(v => v.FullName))
                                {
                                    <span class="badge rounded-pill bg-light text-dark border me-1">@v.FullName</span>
                                }
                            </td>
                            <td class="text-end text-nowrap">
                                <a asp-action="Edit" asp-route-id="@u.Id" class="btn btn-sm btn-outline-primary">Düzenle</a>
                                <a asp-action="Delete" asp-route-id="@u.Id" class="btn btn-sm btn-outline-danger">Sil</a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
}
