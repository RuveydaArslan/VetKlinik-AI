@model VetKlinik.ViewModels.VeterinerFormViewModel
@{
    ViewData["Title"] = "Veteriner Düzenle";
}

<h1 class="h3 text-vet fw-bold mb-4">Veteriner Düzenle</h1>

<div class="card border-0 shadow-sm">
    <div class="card-body p-4">
        <form asp-action="Edit" asp-route-id="@Model.Id" method="post">
            <input type="hidden" asp-for="Id" />
            <partial name="_Form" model="Model" />
            <hr />
            <div class="d-flex gap-2">
                <button type="submit" class="btn btn-vet">Güncelle</button>
                <a asp-action="Details" asp-route-id="@Model.Id" class="btn btn-outline-secondary">Vazgeç</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
