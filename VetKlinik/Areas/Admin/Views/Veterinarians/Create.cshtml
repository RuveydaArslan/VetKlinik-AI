@model VetKlinik.ViewModels.VeterinerFormViewModel
@{
    ViewData["Title"] = "Yeni Veteriner";
}

<h1 class="h3 text-vet fw-bold mb-4">Yeni Veteriner</h1>

<div class="card border-0 shadow-sm">
    <div class="card-body p-4">
        <form asp-action="Create" method="post">
            <partial name="_Form" model="Model" />
            <hr />
            <div class="d-flex gap-2">
                <button type="submit" class="btn btn-vet">Kaydet</button>
                <a asp-action="Index" class="btn btn-outline-secondary">Vazgeç</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
