@model Clinic
@{
    ViewData["Title"] = Model.Name;
    // Yeni saat formu için varsayılan değerler
    var yeniSaat = new ClinicWorkingHour { ClinicId = Model.Id, OpenTime = new TimeOnly(9, 0), CloseTime = new TimeOnly(18, 0) };
}

<div class="d-flex justify-content-between align-items-start mb-4">
    <div>
        <h1 class="h3 mb-0 text-vet fw-bold">@Model.Name</h1>
        <p class="text-muted mb-0">@Model.Address · @Model.Phone @(string.IsNullOrEmpty(Model.Email) ? "" : "· " + Model.Email)</p>
    </div>
    <div class="text-nowrap">
        <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-outline-primary">Düzenle</a>
        <a asp-action="Index" class="btn btn-outline-secondary">Listeye Dön</a>
    </div>
</div>

<div class="row g-4">
    <!-- Çalışma saatleri -->
    <div class="col-lg-7">
        <div class="card border-0 shadow-sm">
            <div class="card-header bg-white fw-semibold">🕘 Çalışma Saatleri</div>
            <div class="card-body p-0">
                <table class="table align-middle mb-0">
                    <tbody>
                        @foreach (var gun in GorunumYardimcilari.HaftaninGunleri())
                        {
                            var saat = Model.WorkingHours.FirstOrDefault(w => w.Day == gun);
                            <tr>
                                <td class="fw-semibold" style="width:30%">@gun.TurkceAd()</td>
                                <td>
                                    @if (saat == null)
                                    {
                                        <span class="text-muted fst-italic">Tanımlanmamış</span>
                                    }
                                    else if (saat.IsClosed)
                                    {
                                        <span class="badge bg-secondary">Kapalı</span>
                                    }
                                    else
                                    {
                                        <span>@saat.OpenTime.ToString("HH:mm") – @saat.CloseTime.ToString("HH:mm")</span>
                                    }
                                </td>
                                <td class="text-end">
                                    @if (saat != null)
                                    {
                                        <form asp-action="DeleteWorkingHour" method="post" class="d-inline"
                                              onsubmit="return confirm('@gun.TurkceAd() günü çalışma saati silinsin mi?');">
                                            <input type="hidden" name="id" value="@saat.Id" />
                                            <input type="hidden" name="clinicId" value="@Model.Id" />
                                            <button type="submit" class="btn btn-sm btn-outline-danger">Sil</button>
                                        </form>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>

        <!-- Saat ekle / güncelle formu -->
        <div class="card border-0 shadow-sm mt-3">
            <div class="card-header bg-white fw-semibold">Çalışma Saati Ekle / Güncelle</div>
            <div class="card-body">
                <p class="small text-muted">Seçilen gün için kayıt varsa güncellenir, yoksa eklenir.</p>
                <form asp-action="SaveWorkingHour" method="post" class="row g-2 align-items-end">
                    <input type="hidden" name="ClinicId" value="@Model.Id" />
                    <div class="col-sm-3">
                        <label class="form-label small">Gün</label>
                        <select name="Day" class="form-select" asp-items="GorunumYardimcilari.GunSecenekleri()"></select>
                    </div>
                    <div class="col-sm-3">
                        <label class="form-label small">Açılış</label>
                        <input type="time" name="OpenTime" class="form-control" value="@yeniSaat.OpenTime.ToString("HH:mm")" />
                    </div>
                    <div class="col-sm-3">
                        <label class="form-label small">Kapanış</label>
                        <input type="time" name="CloseTime" class="form-control" value="@yeniSaat.CloseTime.ToString("HH:mm")" />
                    </div>
                    <div class="col-sm-3">
                        <div class="form-check mb-2">
                            <input type="checkbox" name="IsClosed" value="true" class="form-check-input" id="kapali" />
                            <label class="form-check-label" for="kapali">Kapalı</label>
                        </div>
                    </div>
                    <div class="col-12">
                        <button type="submit" class="btn btn-vet">Kaydet</button>
                    </div>
                </form>
            </div>
        </div>
    </div>

    <!-- Kliniğe bağlı hizmetler ve hekimler -->
    <div class="col-lg-5">
        <div class="card border-0 shadow-sm mb-4">
            <div class="card-header bg-white fw-semibold d-flex justify-content-between">
                💉 Hizmetler
                <a asp-controller="Services" asp-action="Create" asp-route-clinicId="@Model.Id" class="small">+ Ekle</a>
            </div>
            <ul class="list-group list-group-flush">
                @foreach (var s in Model.Services.OrderBy(s => s.Name))
                {
                    <li class="list-group-item d-flex justify-content-between">
                        <span>@s.Name @if (!s.IsActive) { <span class="badge bg-secondary">Pasif</span> }</span>
                        <span class="text-muted small">@s.DurationMinutes dk · @s.Price.ToString("N2") ₺</span>
                    </li>
                }
                @if (!Model.Services.Any())
                {
                    <li class="list-group-item text-muted">Hizmet yok.</li>
                }
            </ul>
        </div>

        <div class="card border-0 shadow-sm">
            <div class="card-header bg-white fw-semibold">🩺 Veterinerler</div>
            <ul class="list-group list-group-flush">
                @foreach (var v in Model.Veterinarians.OrderBy(v => v.FullName))
                {
                    <li class="list-group-item">@v.Title @v.FullName</li>
                }
                @if (!Model.Veterinarians.Any())
                {
                    <li class="list-group-item text-muted">Veteriner yok.</li>
                }
            </ul>
        </div>
    </div>
</div>
