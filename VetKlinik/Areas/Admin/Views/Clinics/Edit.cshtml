@model Clinic
@{
    ViewData["Title"] = "Klinik Düzenle";
}

<h1 class="h3 text-vet fw-bold mb-4">Klinik Düzenle</h1>

<div class="card border-0 shadow-sm form-card">
    <div class="card-body">
        <form asp-action="Edit" asp-route-id="@Model.Id" method="post">
            <input type="hidden" asp-for="Id" />
            <partial name="_Form" model="Model" />
            <div class="d-flex gap-2">
                <button type="submit" class="btn btn-vet">Güncelle</button>
                <a asp-action="Details" asp-route-id="@Model.Id" class="btn btn-outline-secondary">Vazgeç</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
