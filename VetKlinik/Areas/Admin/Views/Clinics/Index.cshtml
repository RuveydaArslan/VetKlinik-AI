@model List<Clinic>
@{
    ViewData["Title"] = "Klinikler";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h1 class="h3 mb-0 text-vet fw-bold">🏥 Klinikler</h1>
        <p class="text-muted mb-0">Sistemde tanımlı veteriner klinikleri</p>
    </div>
    <a asp-action="Create" class="btn btn-vet">+ Yeni Klinik</a>
</div>

@if (!Model.Any())
{
    <div class="alert alert-light border">Henüz klinik eklenmemiş.</div>
}
else
{
    <div class="card border-0 shadow-sm">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th>Klinik Adı</th>
                        <th>Adres</th>
                        <th>Telefon</th>
                        <th>Açık Gün</th>
                        <th class="text-end">İşlemler</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var k in Model)
                    {
                        <tr>
                            <td class="fw-semibold">@k.Name</td>
                            <td class="small">@k.Address</td>
                            <td>@k.Phone</td>
                            <td>@k.WorkingHours.Count(w => !w.IsClosed) gün</td>
                            <td class="text-end text-nowrap">
                                <a asp-action="Details" asp-route-id="@k.Id" class="btn btn-sm btn-outline-secondary">Detay / Saatler</a>
                                <a asp-action="Edit" asp-route-id="@k.Id" class="btn btn-sm btn-outline-primary">Düzenle</a>
                                <a asp-action="Delete" asp-route-id="@k.Id" class="btn btn-sm btn-outline-danger">Sil</a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
}
