@{
    ViewData["Title"] = "Ana Sayfa";
}

<section class="hero-vet text-center text-white">
    <div class="display-3 mb-2">🐾</div>
    <h1 class="fw-bold">VetKlinik'e Hoş Geldiniz</h1>
    <p class="lead mb-4">Evcil dostlarınızın sağlığı için randevu, aşı ve muayene takibi tek yerde.</p>
    @if (!User.Identity!.IsAuthenticated)
    {
        <a asp-controller="Account" asp-action="Register" class="btn btn-light btn-lg text-vet fw-semibold me-2">Hemen Üye Ol</a>
        <a asp-controller="Account" asp-action="Login" class="btn btn-outline-light btn-lg">Giriş Yap</a>
    }
</section>
