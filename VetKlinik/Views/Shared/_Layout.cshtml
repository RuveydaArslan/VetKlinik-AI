<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - VetKlinik</title>
    <script type="importmap"></script>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/VetKlinik.styles.css" asp-append-version="true" />
</head>
<body>
    <header>
        <!-- Lacivert-mor geçişli üst menü -->
        <nav class="navbar navbar-expand-sm navbar-dark navbar-vet mb-4">
            <div class="container">
                <a class="navbar-brand fw-bold" asp-area="" asp-controller="Home" asp-action="Index">🐾 VetKlinik</a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse" aria-controls="navbarSupportedContent"
                        aria-expanded="false" aria-label="Menüyü aç/kapat">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="navbar-collapse collapse d-sm-inline-flex justify-content-between">
                    <ul class="navbar-nav flex-grow-1">
                        <li class="nav-item">
                            <a class="nav-link" asp-area="" asp-controller="Home" asp-action="Index">Ana Sayfa</a>
                        </li>

                        @* ---------- Rol bazlı menü ---------- *@
                        @if (User.IsInRole(Roles.Admin))
                        {
                            <li class="nav-item dropdown">
                                <a class="nav-link dropdown-toggle" href="#" role="button" data-bs-toggle="dropdown" aria-expanded="false">Yönetim</a>
                                <ul class="dropdown-menu">
                                    <li><a class="dropdown-item" asp-area="Admin" asp-controller="Dashboard" asp-action="Index">📊 Yönetim Paneli</a></li>
                                    <li><hr class="dropdown-divider" /></li>
                                    @* Aşağıdaki sayfalar ilerleyen günlerde eklenecek *@
                                    <li><a class="dropdown-item" asp-area="Admin" asp-controller="Clinics" asp-action="Index">🏥 Klinikler</a></li>
                                    <li><a class="dropdown-item" asp-area="Admin" asp-controller="Services" asp-action="Index">💉 Hizmetler</a></li>
                                    <li><a class="dropdown-item" asp-area="Admin" asp-controller="Specialties" asp-action="Index">🎓 Uzmanlık Alanları</a></li>
                                    <li><a class="dropdown-item" asp-area="Admin" asp-controller="Veterinarians" asp-action="Index">🩺 Veterinerler</a></li>
                                    <li><span class="dropdown-item disabled">📅 Randevular</span></li>
                                </ul>
                            </li>
                        }
                        else if (User.IsInRole(Roles.Veteriner))
                        {
                            <li class="nav-item">
                                <a class="nav-link" asp-area="Vet" asp-controller="Dashboard" asp-action="Index">Veteriner Paneli</a>
                            </li>
                            <li class="nav-item">
                                <span class="nav-link disabled">Randevularım</span>
                            </li>
                        }
                        else if (User.IsInRole(Roles.Uye))
                        {
                            <li class="nav-item">
                                <a class="nav-link" asp-area="" asp-controller="Panel" asp-action="Index">Panelim</a>
                            </li>
                            <li class="nav-item">
                                <span class="nav-link disabled">Evcil Hayvanlarım</span>
                            </li>
                            <li class="nav-item">
                                <span class="nav-link disabled">Randevu Al</span>
                            </li>
                        }
                    </ul>
                    <partial name="_LoginPartial" />
                </div>
            </div>
        </nav>
    </header>
    <div class="container">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    @* Başarı / hata mesajları sayfanın ortasında küçük kutucuk olarak gösterilir *@
    <partial name="_Bildirim" />

    <footer class="footer footer-vet">
        <div class="container">
            &copy; 2026 - VetKlinik - <a asp-area="" asp-controller="Home" asp-action="Privacy">Gizlilik</a>
        </div>
    </footer>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
